# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_ENABLED=true

# SMTP — Mailtrap (free, for testing)
# Sign up at https://mailtrap.io → Email Testing → SMTP Settings
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=<your_mailtrap_user>
SMTP_PASS=<your_mailtrap_password>

# Sender address shown in emails
MAIL_FROM=noreply@abonnement.local

# Fallback recipient when user_email is not in the event payload
DEFAULT_RECIPIENT=test@example.com
